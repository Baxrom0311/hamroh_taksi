# Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_ADMIN_IDS=123456789,987654321

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hamroh_bot
DB_USER=hamroh_user
DB_PASSWORD=your_strong_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Panel
ADMIN_ALLOWED_IPS=127.0.0.1,192.168.1.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$...  # Use scripts/create_admin.py

# SMS Provider (Eskiz.uz example)
SMS_PROVIDER=eskiz
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_EMAIL=your_email@example.com
SMS_API_PASSWORD=your_sms_password

# Application Settings
COMMISSION_AMOUNT=5000
MAX_PICKUP_DISTANCE_KM=50
AUTO_CONFIRM_DELAY_SECONDS=120

# Rate Limiting
SMS_RATE_LIMIT_PER_DAY=5
SMS_RATE_LIMIT_PER_HOUR=3
MAX_DRIVER_REJECTS_PER_DAY=50

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hamroh_{time:YYYY-MM-DD}.log

# Environment
ENVIRONMENT=production  # development, staging, production
