# Bot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_ADMIN_IDS=5146421024

# Database (Docker default: service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hamroh_bot
DB_USER=hamroh_user
DB_PASSWORD=root

# Redis (Docker default: service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=root 
REDIS_DB=0

# Celery (reuse Redis)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

# JWT
JWT_SECRET_KEY=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Panel
ADMIN_ALLOWED_IPS=127.0.0.1,192.168.1.1
# NOTE: Admin accounts are created via scripts/create_admin.py script

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=pass

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# SMS Provider (Eskiz.uz example)
SMS_PROVIDER=eskiz
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_EMAIL=your_email@example.com
SMS_API_PASSWORD=your_sms_password

# Application Settings
COMMISSION_AMOUNT=5000
MAX_PICKUP_DISTANCE_KM=50
AUTO_CONFIRM_DELAY_SECONDS=120

# Rate Limiting
SMS_RATE_LIMIT_PER_DAY=5
SMS_RATE_LIMIT_PER_HOUR=3
MAX_DRIVER_REJECTS_PER_DAY=50

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hamroh_{time:YYYY-MM-DD}.log

# Environment
ENVIRONMENT=production  # development, staging, production
IS_DEVELOPMENT=False
