# =============================================
# NORTHFLANK ACCOUNT 1 — Bot + Admin Panel
# =============================================
# PostgreSQL shu akkauntda (ichki ulanish)
# Redis akkaunt 2 dan (tashqi TLS ulanish)
# =============================================

# Bot
BOT_TOKEN=7975253523:AAE-tngQP1vQ_0j0qSf5Th1GJiBLwvXbx_k
BOT_ADMIN_IDS=5146421024
QUEUE_TURN_STICKER_ID=

# PostgreSQL — ICHKI (shu akkauntdagi addon)
# Northflank addon connection details dan oling
DB_HOST=<northflank-postgres-internal-host>
DB_PORT=5432
DB_NAME=hamroh_bot
DB_USER=hamroh_user
DB_PASSWORD=<northflank-postgres-password>

# Redis — TASHQI (akkaunt 2 dagi addon, TLS orqali)
# Akkaunt 2 dagi Redis addon → Connection Details → External dan oling
# MUHIM: rediss:// (ikki s) — TLS ulanish!
REDIS_URL=rediss://:<redis-password>@<akkaunt2-redis-external-host>:<port>/0

# Celery (Redis orqali)
# REDIS_URL dan avtomatik olinadi, alohida set qilish shart emas

# JWT
JWT_SECRET_KEY=<openssl rand -hex 32 bilan generatsiya qiling>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Panel
ADMIN_ALLOWED_IPS=*

# SMS Provider
SMS_PROVIDER=eskiz
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_EMAIL=your_email@example.com
SMS_API_PASSWORD=your_sms_password

# Application Settings
COMMISSION_AMOUNT=5000
MAX_PICKUP_DISTANCE_KM=50
AUTO_CONFIRM_DELAY_SECONDS=120

# Rate Limiting
SMS_RATE_LIMIT_PER_DAY=5
SMS_RATE_LIMIT_PER_HOUR=3
MAX_DRIVER_REJECTS_PER_DAY=50

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=production
