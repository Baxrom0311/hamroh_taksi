# =============================================
# NORTHFLANK ACCOUNT 2 — Celery Worker + Beat
# =============================================
# Redis shu akkauntda (ichki ulanish)
# PostgreSQL akkaunt 1 dan (tashqi TLS ulanish)
# =============================================

# Bot (Celery task larda Telegram API chaqiriladi)
BOT_TOKEN=7975253523:AAE-tngQP1vQ_0j0qSf5Th1GJiBLwvXbx_k
BOT_ADMIN_IDS=5146421024

# PostgreSQL — TASHQI (akkaunt 1 dagi addon, TLS orqali)
# Akkaunt 1 dagi PostgreSQL addon → Connection Details → External dan oling
# MUHIM: ?sslmode=require qo'shilgan bo'lishi kerak!
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<akkaunt1-postgres-external-host>:<port>/hamroh_bot?ssl=require

# DB_PASSWORD — DATABASE_URL ishlatilganda ham kerak (validation uchun)
DB_PASSWORD=<northflank-postgres-password>

# Redis — ICHKI (shu akkauntdagi addon)
# Northflank addon connection details dan oling
REDIS_HOST=<northflank-redis-internal-host>
REDIS_PORT=6379
REDIS_PASSWORD=<northflank-redis-password>
REDIS_DB=0

# JWT (Celery task larda kerak emas, lekin settings validation uchun)
JWT_SECRET_KEY=<same-as-account1>

# Application Settings
COMMISSION_AMOUNT=5000
MAX_PICKUP_DISTANCE_KM=50
AUTO_CONFIRM_DELAY_SECONDS=120

# Rate Limiting
SMS_RATE_LIMIT_PER_DAY=5
SMS_RATE_LIMIT_PER_HOUR=3
MAX_DRIVER_REJECTS_PER_DAY=50

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=production
